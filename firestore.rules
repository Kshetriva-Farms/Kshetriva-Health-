rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin' || 
        request.auth.token.email.matches('.*@kshetriva\\.com$')
      );
    }

    // User Profiles Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        // Prevent self-elevation on account creation: new accounts must start unsubscribed.
        && request.resource.data.subscriptionActive == false
        && request.resource.data.subscriptionTier in ['NONE', 'none'];
      // Owners can edit their own profile, but NOT their subscription fields directly —
      // those must only change via an admin/trusted backend (e.g. a Cloud Function
      // verifying a Razorpay webhook with the Admin SDK, which bypasses these rules).
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.subscriptionActive == resource.data.subscriptionActive &&
        request.resource.data.subscriptionTier == resource.data.subscriptionTier
      );
      allow delete: if isAdmin();
    }

    // Vitals & Tracking Collection
    match /users/{userId}/vitals/{vitalId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Meals & Calorie Log Collection
    match /users/{userId}/meals/{mealId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Water Log Collection
    match /users/{userId}/water/{waterId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Weight Log Collection
    match /users/{userId}/weight/{weightId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Subscriptions Collection
    // Assumes each subscription document stores a `userId` field identifying its owner.
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only a trusted backend (verifying Razorpay payment/webhooks) or an admin should write these.
      allow write: if isAdmin();
    }

    // Public Recipe Catalog (Read-only for public, Write for Admin)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Produce Harvest Catalog
    match /vegetables/{veggieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users may only create an order under their own uid. Payment amount/status
      // should still be confirmed server-side (via a Cloud Function + Razorpay
      // webhook) before being treated as authoritative — this rule only stops
      // a user from writing an order that impersonates someone else.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin Broadcast Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
